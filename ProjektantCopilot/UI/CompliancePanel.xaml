<UserControl x:Class="ProjektantCopilot.UI.CompliancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="400"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2563EB" Padding="15">
            <StackPanel>
                <TextBlock Text="Compliance Monitor"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Real-time building code compliance"
                           FontSize="11"
                           Foreground="#E0E7FF"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Stats -->
        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TotalChecked}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Checked"
                               FontSize="10"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding CompliantCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#10B981"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Compliant"
                               FontSize="10"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding ViolationCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#EF4444"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Violations"
                               FontSize="10"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="15,10"
                                Background="{Binding BackgroundBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="8"
                                             Height="8"
                                             Fill="{Binding StatusBrush}"
                                             Margin="0,4,8,0"
                                             VerticalAlignment="Top"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ElementName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding ElementId}"
                                                   FontSize="10"
                                                   Foreground="#6B7280"
                                                   Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding SummaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="View Details"
                                        HorizontalAlignment="Right"
                                        Padding="8,4"
                                        Margin="0,5,0,0"
                                        FontSize="10"
                                        Click="ViewDetails_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="15,10">
            <StackPanel>
                <Button Content="Check Selected Elements"
                        Padding="10,6"
                        Click="CheckSelected_Click"
                        Margin="0,0,0,5"/>
                <Button Content="Check All Elements"
                        Padding="10,6"
                        Click="CheckAll_Click"
                        Margin="0,0,0,5"/>
                <Button Content="Settings"
                        Padding="10,6"
                        Click="Settings_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
