<Window x:Class="ProjektantCopilot.UI.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compliance Settings"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Plugin Settings"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API Settings -->
                <TextBlock Text="API Configuration"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Backend URL:"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="BackendUrlTextBox"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <TextBlock Text="API Key:"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Padding="8"
                             Margin="0,0,0,15"/>

                <Button Content="Test Connection"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        Click="TestConnection_Click"
                        Margin="0,0,0,20"/>

                <!-- Monitoring Settings -->
                <TextBlock Text="Real-time Monitoring"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,10,0,10"/>

                <CheckBox x:Name="EnableMonitoringCheckBox"
                          Content="Enable real-time compliance monitoring"
                          Margin="0,0,0,10"
                          Checked="EnableMonitoring_Changed"
                          Unchecked="EnableMonitoring_Changed"/>

                <TextBlock Text="Monitored Categories:"
                           Margin="0,10,0,5"/>

                <StackPanel Margin="20,0,0,0">
                    <CheckBox x:Name="MonitorWallsCheckBox"
                              Content="Walls"
                              IsChecked="True"
                              Margin="0,5,0,0"/>
                    <CheckBox x:Name="MonitorDoorsCheckBox"
                              Content="Doors"
                              IsChecked="True"
                              Margin="0,5,0,0"/>
                    <CheckBox x:Name="MonitorWindowsCheckBox"
                              Content="Windows"
                              IsChecked="True"
                              Margin="0,5,0,0"/>
                    <CheckBox x:Name="MonitorFloorsCheckBox"
                              Content="Floors"
                              IsChecked="True"
                              Margin="0,5,0,0"/>
                    <CheckBox x:Name="MonitorCeilingsCheckBox"
                              Content="Ceilings"
                              IsChecked="True"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Notification Settings -->
                <TextBlock Text="Notifications"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,20,0,10"/>

                <CheckBox x:Name="ShowNotificationsCheckBox"
                          Content="Show toast notifications"
                          IsChecked="True"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="NotifyOnlyViolationsCheckBox"
                          Content="Notify only on violations"
                          IsChecked="True"
                          Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Save"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    Click="Save_Click"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Padding="20,8"
                    Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
