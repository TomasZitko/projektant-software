<Window x:Class="ProjektantCopilot.UI.NotificationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compliance Notification"
        Width="400" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(Window.Left)"
                           From="{Binding SlideFromX}"
                           To="{Binding SlideToX}"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(Window.Opacity)"
                           From="0"
                           To="1"
                           Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetProperty="(Window.Left)"
                           To="{Binding SlideFromX}"
                           Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(Window.Opacity)"
                           To="0"
                           Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="2" Margin="10"
            Background="White"
            BorderBrush="{Binding BorderColor}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                <Button Content="×"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Padding="5,0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        Margin="Auto,0,0,0"/>
            </StackPanel>

            <!-- Element Info -->
            <TextBlock Grid.Row="1"
                       Text="{Binding ElementInfo}"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,0,0,10"/>

            <!-- Message -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="View Details"
                        Padding="8,4"
                        Margin="0,0,5,0"
                        Click="ViewDetails_Click"
                        Visibility="{Binding DetailsButtonVisibility}"/>
                <Button Content="Dismiss"
                        Padding="8,4"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
